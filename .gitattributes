# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts and anything executed on the Linux target MUST use LF.
# A CRLF line ending in a shebang line makes the kernel fail with
# "bad interpreter: No such file or directory".
*.sh            text eol=lf
*.env           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
Caddyfile       text eol=lf
.dockerignore   text eol=lf
bin/*           text eol=lf
assets/app/dockerignore text eol=lf
